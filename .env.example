# Copy this file to .env and fill in your own values.
# Trading 212 app -> Settings -> API (Beta) -> Generate key.
# Give it READ-ONLY permissions: Account data, Portfolio, Metadata. Do not enable order placement.
T212_API_KEY=
# Newer keys also come with a secret; leave blank if yours didn't.
T212_API_SECRET=
# live = real money account, demo = Trading 212 practice account
T212_ENV=live
PORT=3212
